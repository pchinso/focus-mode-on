# Copy this file to ".env" and fill in your values.
# The .env file is gitignored and loaded automatically at startup.
# Real environment variables always override values set here.

# Login password for the app (required before exposing it).
APP_PASSWORD=change-me

# Key used to sign session cookies. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset, a random key is used per run (sessions reset on restart).
APP_SECRET_KEY=

# OpenAI API key. Enables the smart command bar and AI thread icons.
# Leave empty to run in local heuristic mode (everything still works).
OPENAI_API_KEY=

# Optional: path to the Markdown vault (defaults to ./vault).
# VAULT_DIR=
